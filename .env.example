# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=hopehive

# Port for local development (Render sets this automatically)
PORT=5000

# Comma-separated list of client origins allowed by CORS
CLIENT_URL=http://localhost:3000,https://your-client.vercel.app

# The Next.js app that runs BetterAuth. Tokens are issued by it and verified here
# against its public JWKS endpoint. No shared secret is needed.
AUTH_BASE_URL=http://localhost:3000
# Optional. Defaults to <AUTH_BASE_URL>/api/auth/jwks
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Timezone used to decide whether an event date is in the past
APP_TIMEZONE=Asia/Dhaka
